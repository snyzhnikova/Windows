<uiConfig xmlns="http://www.testlum.com/testing/model/global-config"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.testlum.com/testing/model/global-config global-config.xsd">
    <web enabled="true">
        <baseUrl>https://testlum.com</baseUrl>
        <autoHealing enabled="false" mode="soft"/>
        <browserSettings>
            <takeScreenshots enabled="false"/>
            <elementAutowait seconds="5"/>
            <browsers>
                <chrome alias="BROWSER"
                        enabled="true"
                        headlessMode="false"
                        keepDownloadedFiles="false"
                        maximizedBrowserWindow="true">
                    <browserType>
                        <localBrowser/>
                    </browserType>
                </chrome>
            </browsers>
        </browserSettings>
    </web>
</uiConfig>